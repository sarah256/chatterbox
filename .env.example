# Copy to .env.local and fill in.

# Clerk (https://dashboard.clerk.com). For local development without an
# account, `npx clerk@latest init --accountless` writes temporary dev keys
# to .env.local.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Neon PostgreSQL connection string (https://console.neon.tech)
DATABASE_URL=

# Model providers (phase 3)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
